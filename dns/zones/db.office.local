$TTL 3600
@   IN  SOA ns1.office.local. admin.office.local. (
        2026103001  ; serial
        3600        ; refresh
        900         ; retry
        604800      ; expire
        300 )       ; negative cache TTL
    IN  NS  ns1.office.local.
    IN  MX  10 mail.office.local.

; ---- Сървъри ----
ns1         IN  A   10.10.0.53
dns         IN  A   10.10.0.53
zabbix      IN  A   10.10.0.10
www         IN  A   10.10.0.20
web         IN  A   10.10.0.20
ftp         IN  A   10.10.0.21
mail        IN  A   10.10.0.25

